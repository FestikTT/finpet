<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Левая колонка: Эмодзи / Аватар питомца -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tv_pet_emoji"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="🦊"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tv_pet_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ур. 1"
            android:textColor="#A1A1AA"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Правая колонка: Имя, показатели, баланс -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_pet_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Питомец"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_pet_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😄 Счастлив"
                android:textColor="#E4E4E7"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Балансы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_widget_coins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🪙 120"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_savings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🎯 50"
                android:textColor="#E4E4E7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Сытость -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tv_hunger_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сытость: 85%"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/pb_hunger"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:max="100"
                android:progress="85"
                android:progressTint="#D4D4D8" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
